{
  "version": 2,
  "rules": [
    {
      "id": "caller-media-permission-mismatch",
      "name": "Caller-ID app requests photo/media access",
      "category": "profile",
      "severity": "HIGH",
      "enabled": true,
      "params": {
        "check": "PERMISSION_NOT_IN_BASELINE",
        "appTypes": ["CALLER_ID"],
        "permissions": [
          "android.permission.READ_MEDIA_IMAGES",
          "android.permission.READ_MEDIA_VIDEO",
          "android.permission.READ_EXTERNAL_STORAGE",
          "android.permission.MANAGE_EXTERNAL_STORAGE"
        ],
        "confidence": 92,
        "reason": "A caller-ID app identifies phone numbers against contacts and call history. Reading the device photo library is outside that role."
      }
    },
    {
      "id": "caller-package-visibility-mismatch",
      "name": "Caller-ID app requests broad package visibility",
      "category": "profile",
      "severity": "HIGH",
      "enabled": true,
      "params": {
        "check": "PERMISSION_NOT_IN_BASELINE",
        "appTypes": ["CALLER_ID"],
        "permissions": [
          "android.permission.QUERY_ALL_PACKAGES"
        ],
        "confidence": 88,
        "reason": "QUERY_ALL_PACKAGES lets an app enumerate every application installed on the device. A caller-ID app resolves phone numbers and has no need for the installed-app list."
      }
    },
    {
      "id": "caller-location-permission-mismatch",
      "name": "Caller-ID app requests precise location",
      "category": "privacy",
      "severity": "MEDIUM",
      "enabled": true,
      "params": {
        "check": "PERMISSION_NOT_IN_BASELINE",
        "appTypes": ["CALLER_ID"],
        "permissions": [
          "android.permission.ACCESS_FINE_LOCATION",
          "android.permission.ACCESS_BACKGROUND_LOCATION"
        ],
        "confidence": 74,
        "reason": "Caller identification is performed on the phone number, not the handset's position. Precise location is outside the declared role."
      }
    },
    {
      "id": "caller-surveillance-capability-mismatch",
      "name": "Caller-ID app requests microphone or camera",
      "category": "privacy",
      "severity": "HIGH",
      "enabled": true,
      "params": {
        "check": "PERMISSION_NOT_IN_BASELINE",
        "appTypes": ["CALLER_ID"],
        "permissions": [
          "android.permission.RECORD_AUDIO",
          "android.permission.CAMERA"
        ],
        "confidence": 90,
        "reason": "Displaying who is calling requires neither the microphone nor the camera."
      }
    },
    {
      "id": "caller-high-risk-profile",
      "name": "Caller-ID app shows a compound profile mismatch",
      "category": "profile",
      "severity": "CRITICAL",
      "enabled": true,
      "params": {
        "check": "PROFILE_MISMATCH_COUNT",
        "appTypes": ["CALLER_ID"],
        "minimumMismatches": 2,
        "confidence": 95,
        "reason": "Several unrelated capabilities sit outside the caller-ID role at once. Any one of them could be argued for in isolation; together they describe an app collecting far more than its stated purpose requires."
      }
    },
    {
