<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        VillainCaller — the controlled suspicious CALLER_ID sample.

        Baseline caller-ID permissions, identical to GoodCaller:
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        ===== DELIBERATE PROFILE MISMATCH — the detectable part =====

        These are declared so Thraksha has something REAL and STATIC to observe. Each is
        genuinely readable by another app through
        PackageManager.getPackageInfo(pkg, GET_PERMISSIONS).

        This app never exercises any of them. It opens no photo, enumerates no package,
        takes no location fix and records no audio. The demo claim is precisely
        "VillainCaller has asked for capabilities a caller-ID app should not need" —
        never "Thraksha watched VillainCaller read your photos", which no Android API
        would support.
    -->

    <!-- Photo/media access: no caller-ID function requires the photo library. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Broad package visibility: the CAPABILITY to enumerate every installed app. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Precise location: outside the caller-ID role. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_action_call"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
