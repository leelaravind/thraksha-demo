# THRAKSHA — PRIVATE-ALPHA RELEASE SIGNING CREDENTIALS (TEMPLATE)
#
# Copy this file to `keystore.properties` in the repository root and fill in the real
# values. `keystore.properties` is git-ignored (.gitignore line 30) and MUST NEVER be
# committed. This template is tracked and MUST NEVER contain a real value.
#
# Alternatively, set the environment variables instead of using a file:
#   THRAKSHA_KEYSTORE_FILE, THRAKSHA_KEYSTORE_PASSWORD,
#   THRAKSHA_KEY_ALIAS, THRAKSHA_KEY_PASSWORD
# The file is consulted first; the environment is the fallback.
#
# ---------------------------------------------------------------------------------------
# WHERE THE KEYSTORE LIVES
# ---------------------------------------------------------------------------------------
# The .jks file must be stored OUTSIDE this repository, in a private directory. Suggested:
#
#   C:\Users\<you>\secure\thraksha\thraksha-private-alpha.jks
#
# The build enforces this: if storeFile resolves to a path inside the repository, the
# build fails with an explicit error rather than risking the key being committed.
#
# Do NOT place it under the project root, app/, temp/, model/, tools/ or .claude/.
#
# ---------------------------------------------------------------------------------------
# KEY CONTINUITY — READ THIS
# ---------------------------------------------------------------------------------------
# Android identifies an installed app by (package name + signing certificate). Every future
# Thraksha private-alpha update MUST be signed with this same key. If the key is lost, no
# future build can update an existing install: the app must be uninstalled first, which
# destroys the encrypted database and the audit chain on that device.
#
# Keep at least one backup of the .jks and its passwords outside the development laptop,
# and outside this repository. Do not rotate casually.
#
# ---------------------------------------------------------------------------------------

# Absolute path to the keystore. On Windows use forward slashes or escaped backslashes,
# e.g. C:/Users/you/secure/thraksha/thraksha-private-alpha.jks
storeFile=

# Password protecting the keystore file.
storePassword=

# Alias of the key inside the keystore.
keyAlias=

# Password protecting that key. May equal storePassword if the key was created that way.
keyPassword=
